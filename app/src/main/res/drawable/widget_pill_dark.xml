<?xml version="1.0" encoding="utf-8"?>
<!-- Widget colour theme "dark". Kept as separate drawables because a widget is
     drawn by the launcher through RemoteViews, which cannot recolour a shape's
     fill at runtime — it can only swap the whole background resource. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#E6212121" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#66FFFFFF" />
</shape>
