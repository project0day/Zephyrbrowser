<?xml version="1.0" encoding="utf-8"?>
<!-- Widget colour theme "sand". Separate drawables because RemoteViews cannot
     recolour a shape's fill at runtime — only swap the background resource. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F2EFE7DA" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#33000000" />
</shape>
