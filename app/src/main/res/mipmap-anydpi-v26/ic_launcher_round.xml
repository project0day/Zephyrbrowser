<?xml version="1.0" encoding="utf-8"?>
<!-- v1.9.14: the Zephyr bird. The foreground is the bird alone on
     transparency, cut out of the source artwork by luminance and sized to the
     adaptive-icon safe zone (66% of the canvas), so every launcher mask —
     circle, squircle, teardrop — crops only empty margin. The background
     reproduces the blue-to-purple field the bird was cut from, and the
     monochrome layer is the same silhouette for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
